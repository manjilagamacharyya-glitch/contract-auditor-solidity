# Gemini AI API Key (required for AI-powered contract analysis)
GEMINI_API_KEY="AIzaSy..."

# Ethereum Sepolia Testnet RPC (Alchemy, Infura, or public RPC)
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/your-api-key"

# Private key of the deployer/auditor wallet with Sepolia ETH (without 0x prefix or with)
PRIVATE_KEY="your-hex-private-key-do-not-commit"

# Deployed AuditRegistry contract address on Sepolia
REGISTRY_ADDRESS="0x1234567890123456789012345678901234567890"

# GitHub Personal Access Token (with repo / pull_request comments permissions)
GITHUB_TOKEN="ghp_yourpersonalaccesstoken"

# GitHub Webhook HMAC SHA-256 Secret
GITHUB_WEBHOOK_SECRET="your-github-webhook-secret"

# Application URL
APP_URL="http://localhost:3000"
